# Front (Vite expõe só variáveis com prefixo VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Skills do Claude Code (nunca no front, nunca com prefixo VITE_)
SUPABASE_SERVICE_ROLE_KEY=

# IA do chatbot e da análise de currículo — secrets das Edge Functions, NÃO vão para o front.
# Configure no projeto: supabase secrets set AI_PROVIDER=openrouter AI_API_KEY=... AI_MODEL=...
# Modelos gratuitos do OpenRouter terminam em ":free" (https://openrouter.ai/models?max_price=0)
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=google/gemma-4-31b-it:free
# Opcional: modelos exibidos no seletor do chat, separados por vírgula.
# Sem isso, usa a lista embutida de modelos :free (o AI_MODEL acima é sempre incluído).
AI_MODELS=
